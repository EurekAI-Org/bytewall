# Images
API_IMAGE_REGISTRY=ghcr.io/eurekai-org/bytewall-api:latest
WORKERS_IMAGE_REGISTRY=ghcr.io/eurekai-org/bytewall-worker:latest

# API
API_PORT=8080

CORS_ORIGIN=*
CORS_ALLOWED_METHODS=*
ALLOWED_EXTENSIONS=*

# PostgreSQL
POSTGRES_DB=bytewall
POSTGRES_USER=bytewall
POSTGRES_PASSWORD=change-me

POSTGRES_URL=postgresql://bytewall:change-me@postgres:5432/bytewall
ASYNC_POSTGRES_URL=postgresql+asyncpg://bytewall:change-me@postgres:5432/bytewall

POSTGRES_CONNECTION_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=change-me

REDIS_URL=redis://:change-me@redis:6379/0

# RabbitMQ / Celery
RABBITMQ_USER=bytewall
RABBITMQ_PASSWORD=change-me

BROKER_URL=amqp://bytewall:change-me@rabbitmq:5672//
BACKEND_URL=redis://:change-me@redis:6379/1

# S3
S3_ENDPOINT_URL=http://your-s3-server:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION_NAME=us-east-1
S3_UPLOAD_BUCKET_NAME=bytewall-quarantine
S3_SANITIZED_BUCKET_NAME=bytewall-clean

# ClamAV
CLAMAV_HOST=your-clamav-host
CLAMAV_PORT=3310

# Workers
MAX_TASK_RETRIES=3

API_MEM_LIMIT=2G
DEFAULT_WORKERS_MEM_LIMIT=2G
SCAN_WORKERS_MEM_LIMIT=2G
BEAT_WORKERS_MEM_LIMIT=2G
